{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocusLock",
  "identifier": "io.github.focuslock",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Focus Lock",
        "width": 880,
        "height": 760,
        "minWidth": 680,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.spotifycdn.com https://i.scdn.co; connect-src ipc: http://ipc.localhost https://open.spotify.com"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "publisher": "FocusLock",
    "shortDescription": "Focus lock for the Spotify desktop app",
    "category": "Productivity",
    "resources": {
      "../../../target/x86_64-pc-windows-msvc/release/focuslock-service.exe": "focuslock-service.exe",
      "../../../target/x86_64-pc-windows-msvc/release/focuslock.exe": "focuslock.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "../../../installer/hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}
